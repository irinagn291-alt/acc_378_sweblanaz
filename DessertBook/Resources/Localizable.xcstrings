    "cloud.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Choose a file to open, or send a copy directly to someone. Changes stay on this device until you share again. Recipes and local changes stay available offline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Öffne eine Datei oder sende jemandem direkt eine Kopie. Änderungen bleiben bis zur nächsten Freigabe auf diesem Gerät. Rezepte und lokale Änderungen bleiben offline verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Ouvrez un fichier ou envoyez une copie directement à un proche. Les modifications restent sur cet appareil jusqu’au prochain partage. Les recettes et modifications locales restent accessibles hors ligne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Abra um arquivo ou envie uma cópia diretamente a alguém. As alterações ficam neste dispositivo até o próximo envio. Receitas e alterações locais continuam acessíveis offline."
          }
        }
      }
    },
