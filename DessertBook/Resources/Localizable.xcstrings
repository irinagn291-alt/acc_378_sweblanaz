    "storage.error": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save changes. Free some storage and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen konnten nicht gespeichert werden. Speicherplatz freigeben und erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer. Libérez de l’espace et réessayez."
          }
        },
        "pt-BR": {
