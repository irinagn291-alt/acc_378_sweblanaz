    "privacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datenschutz"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confidentialité"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacidade"
          }
        }
      }
    },
    "privacy.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No ads, purchases, analytics or tracking. Choose a file to open, or send a copy directly to someone. Changes stay on this device until you share again. Shopping and timers are shared only with your widgets. Reminder export uses Apple Reminders only when requested. No camera, microphone or location access."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Werbung, Käufe, Analyse oder Tracking. Öffne eine Datei oder sende jemandem direkt eine Kopie. Änderungen bleiben bis zur nächsten Freigabe auf diesem Gerät. Einkaufsliste und Timer werden nur mit deinen Widgets geteilt. Erinnerungen werden nur auf Wunsch exportiert. Kein Zugriff auf Kamera, Mikrofon oder Standort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans publicité, achat, analyse ni suivi. Ouvrez un fichier ou envoyez une copie directement à un proche. Les modifications restent sur cet appareil jusqu’au prochain partage. Courses et minuteurs sont partagés uniquement avec vos widgets. L’export vers Rappels se fait à votre demande. Aucun accès caméra, micro ou localisation."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem anúncios, compras, análise ou rastreamento. Abra um arquivo ou envie uma cópia diretamente a alguém. As alterações ficam neste dispositivo até o próximo envio. Compras e temporizadores são compartilhados só com seus widgets. A exportação para Lembretes ocorre quando solicitada. Sem câmera, microfone ou localização."
          }
        }
      }
    },
    "about": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        },
        "de": {
