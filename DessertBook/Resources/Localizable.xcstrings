    "cloud.full": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your notebook is too large to sync. Local saving remains active."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein privates Notizbuch ist für einen Abgleich zu groß. Lokales Speichern bleibt aktiv."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre carnet est trop volumineux pour cette synchronisation. L’enregistrement local reste actif."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu caderno é grande demais para sincronizar. O salvamento local continua ativo."
          }
        }
      }
    },
    "cloud.storage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a file to open, or send a copy directly to someone. Changes stay on this device until you share again. Changes stay on this device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne eine Datei oder sende jemandem direkt eine Kopie. Änderungen bleiben bis zur nächsten Freigabe auf diesem Gerät. Änderungen bleiben auf diesem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez un fichier ou envoyez une copie directement à un proche. Les modifications restent sur cet appareil jusqu’au prochain partage. Les modifications restent ici."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um arquivo ou envie uma cópia diretamente a alguém. As alterações ficam neste dispositivo até o próximo envio. As alterações ficam neste aparelho."
          }
        }
      }
    },
