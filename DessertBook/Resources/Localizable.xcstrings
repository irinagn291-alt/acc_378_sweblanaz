    "about.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small, free cookbook for everyday home baking. Metric measures. A teaspoon is 5 ml; a tablespoon is 15 ml. Seasons follow the Northern Hemisphere calendar. Adjust cooking times to your oven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kleines kostenloses Backbuch. Metrische Maße. Ein TL hat 5 ml, ein EL 15 ml. Jahreszeiten nach dem Kalender der Nordhalbkugel. Backzeiten an deinen Ofen anpassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit carnet de pâtisserie gratuit. Mesures métriques : cuillère à café de 5 ml, cuillère à soupe de 15 ml. Saisons de l’hémisphère nord. Adaptez les temps à votre four."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pequeno livro gratuito de confeitaria caseira. Medidas métricas: colher de chá de 5 ml, colher de sopa de 15 ml. Estações do Hemisfério Norte. Ajuste os tempos ao seu forno."
          }
        }
      }
    },
